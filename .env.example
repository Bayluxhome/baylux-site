# Пример переменных окружения. Реальные значения НЕ коммитим — задаются в хостинге (Vercel).

# --- Интеграция с BAYLUX CRM: трекинг кликов «Связаться в Telegram» ---
# Общий секрет вебхука. Только серверная переменная — не префиксить NEXT_PUBLIC_.
# Сайт шлёт его в заголовке x-baylux-webhook-secret при обращении к CRM.
BAYLUX_CRM_WEBHOOK_SECRET=

# URL приёмника событий в CRM.
# Тест (временный Cloudflare Quick Tunnel — адрес меняется при перезапуске):
#   https://<tunnel>.trycloudflare.com/s/baylux/site/telegram-click
# Production — постоянный домен CRM:
#   https://<crm-domain>/s/baylux/site/telegram-click
BAYLUX_CRM_TELEGRAM_CLICK_URL=
